{
  "name": "ms-pesaschile-quote-service",
  "version": "0.1.0",
  "private": true,
  "description": "PesasChile Quote Service V1",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:compose:up": "docker compose up -d postgres",
    "db:compose:down": "docker compose down",
    "db:migrate": "tsx src/scripts/migrate.ts up",
    "db:migrate:down": "tsx src/scripts/migrate.ts down",
    "db:check": "tsx src/scripts/db-check.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
