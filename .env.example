NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_CONNECTION_TIMEOUT_MS=5000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
APP_SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pesaschile_quote_service
DATABASE_SSL_MODE=disable
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000
SERVICE_NAME=pesaschile-quote-service
SERVICE_VERSION=0.1.0
SERVICE_AUTH_TOKEN=replace-me
HEALTHCHECK_DATABASE_TIMEOUT_MS=2000
QUOTE_COMPANY_NAME=Pesas Chile SPA
QUOTE_DOCUMENT_STORAGE_ROOT=./var/quote-documents
QUOTE_DOCUMENT_REF_SECRET=replace-with-a-long-secret
QUOTE_RENDER_VERSION=quote-v1
QUOTE_PDF_RENDER_TIMEOUT_MS=15000
QUOTE_PDF_EXECUTABLE_PATH=
QUOTE_EXPIRATION_SCHEDULER_ENABLED=false
QUOTE_EXPIRATION_INTERVAL_MS=30000
QUOTE_EXPIRATION_BATCH_SIZE=25
QUOTE_DOCUMENT_CLEANUP_ENABLED=false
QUOTE_DOCUMENT_CLEANUP_INTERVAL_MS=60000
QUOTE_DOCUMENT_ORPHAN_MIN_AGE_MS=300000
