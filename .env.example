NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_CONNECTION_TIMEOUT_MS=5000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
APP_SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pesaschile_quote_service
DATABASE_SSL_MODE=disable
# Used only by db:migrate / db:check (explicit DDL path); falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgres://quote_migrator:change-me@localhost:5432/pesaschile_quote_service
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000
SERVICE_NAME=pesaschile-quote-service
SERVICE_VERSION=0.1.0
# Principal registry (docs/principals.md): exactly one of the two. Only token
# SHA-256 hashes are stored; generate tokens with `npm run principals:token`.
# The V1 SERVICE_AUTH_TOKEN is retired.
QUOTE_PRINCIPAL_REGISTRY_FILE=./var/principals.json
# QUOTE_PRINCIPAL_REGISTRY_JSON={"version":1,"principals":[...]}
# Dependency monitor (docs/runtime-lifecycle.md)
HEALTH_PROBE_TIMEOUT_MS=2000
HEALTH_PROBE_INTERVAL_MS=10000
HEALTH_PROBE_RETRY_MIN_MS=1000
HEALTH_PROBE_RETRY_MAX_MS=30000
QUOTE_COMPANY_NAME=Pesas Chile SPA
QUOTE_DOCUMENT_STORAGE_ROOT=./var/quote-documents
QUOTE_RENDER_VERSION=quote-pdf-v2-pdfmake
# Issuance operation (docs/v2 Idempotency §4.2; ranges enforced at startup).
# The deadline is copied onto each operation when it is accepted.
QUOTE_ISSUANCE_LEASE_MS=60000
QUOTE_ISSUANCE_POLL_INTERVAL_MS=2000
QUOTE_ISSUANCE_DEADLINE_MS=86400000
QUOTE_ISSUANCE_SYNC_BUDGET_MS=5000
# Email is an optional subsystem and off by default. Setting "gmail" requires
# every GOOGLE_GMAIL_* and QUOTE_EMAIL_FROM_* value below to be non-empty.
QUOTE_EMAIL_PROVIDER=disabled

# GOOGLE_GMAIL_CLIENT_ID=
# GOOGLE_GMAIL_CLIENT_SECRET=
# GOOGLE_GMAIL_REFRESH_TOKEN=
# GOOGLE_GMAIL_USER=tu_correo@gmail.com

# QUOTE_EMAIL_FROM_ADDRESS=tu_correo@gmail.com
# QUOTE_EMAIL_FROM_NAME=Pesas Chile
# QUOTE_EMAIL_REPLY_TO=tu_correo@gmail.com
