# Non-secret Quote V2 settings for the EC2 integration deployment.
# Secrets (DATABASE_URL) live in ${QUOTE_V2_SECRETS_DIR}/runtime.secret.env.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=quote-v2-integration
SERVICE_VERSION=6735352
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=/run/quote-tls/ca.crt
DB_POOL_MAX=5
QUOTE_PRINCIPAL_REGISTRY_FILE=/run/quote-secrets/principals.json
QUOTE_DOCUMENT_STORAGE_ROOT=/var/lib/pesaschile/quote-documents
APP_SHUTDOWN_TIMEOUT_MS=10000
QUOTE_EMAIL_PROVIDER=disabled
QUOTE_INTEGRITY_CHECK_INTERVAL_MS=0
